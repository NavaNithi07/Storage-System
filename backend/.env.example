# ─────────────────────────────────────────────────────────────────────────────
# VIBNA Storage — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL (recommended) or any PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your Vercel URL e.g. https://vibna-storage.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# FIREBASE_PROJECT_ID is required to verify Google Sign-In tokens.
# Get from: Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Full service account credentials for production Admin SDK verification
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
