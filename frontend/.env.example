# ─────────────────────────────────────────────────────────────────────────────
# VIBNA Storage — Frontend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local dev: http://localhost:5000/api
# Production: your Render/Railway backend URL e.g. https://vibna-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# ─── App URL ──────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your Vercel URL e.g. https://vibna-storage.vercel.app
VITE_APP_URL=http://localhost:5173

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
